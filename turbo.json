{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["eslint.config.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "db:generate": {
      "outputs": ["src/generated/**"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["transit", "db:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit", "db:generate"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
