{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:api-web": "turbo run dev --filter=api --filter=web",
    "dev:api-mobile": "turbo run dev --filter=api --filter=mobile",
    "new-feature": "node scripts/new-feature.mjs",
    "codegraph:init": "npx -y @colbymchenry/codegraph@1.6.2 init",
    "codegraph:status": "npx -y @colbymchenry/codegraph@1.6.2 status",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,scss,html,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css,scss,html,yaml,yml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "semantic-release": "25.0.3",
    "turbo": "2.9.14"
  },
  "name": "omni",
  "packageManager": "pnpm@10.11.0",
  "version": "1.1.1",
  "engines": {
    "node": ">=24"
  }
}
