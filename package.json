{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:api-web": "turbo run dev --filter=api --filter=web",
    "dev:api-mobile": "turbo run dev --filter=api --filter=mobile",
    "web:new-feature": "node apps/web/scripts/new-feature.mjs",
    "web:new-hook": "node apps/web/scripts/new-hook.mjs",
    "web:new-component": "node apps/web/scripts/new-component.mjs",
    "web:new-test": "node apps/web/scripts/new-test.mjs",
    "codegraph:init": "npx @colbymchenry/codegraph init",
    "codegraph:status": "npx @colbymchenry/codegraph status",
    "codegraph:sync": "npx @colbymchenry/codegraph sync",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,scss,html,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css,scss,html,yaml,yml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "semantic-release": "25.0.3",
    "turbo": "2.9.14",
    "vitest": "^4.1.6"
  },
  "name": "omni",
  "packageManager": "pnpm@10.11.0",
  "version": "1.0.2",
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.25",
      "undici": ">=8.9.0",
      "ws@>=8": ">=8.21.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@4": "5.0.8",
      "js-yaml": ">=4.3.0",
      "immutable": ">=5.1.8",
      "fast-uri": ">=3.1.4",
      "postcss": ">=8.5.18",
      "react-router": ">=7.18.0",
      "ip-address": ">=10.3.1"
    }
  }
}
