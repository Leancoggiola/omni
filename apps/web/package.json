{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --clearScreen false",
    "build": "tsc && vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check-api-paths": "node scripts/check-api-paths.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/dates": "9.6.1",
    "@mantine/form": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/lightbox": "9.6.1",
    "@mantine/notifications": "9.6.1",
    "@omni/shared": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "dayjs": "1.11.20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "swr": "2.4.1"
  },
  "devDependencies": {
    "@omni/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
