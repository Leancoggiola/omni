{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://omni-api-gwer.onrender.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/((?!assets/)(?!.*\\.[a-zA-Z0-9]+$).*)", "dest": "/index.html" }
  ]
}
