{
  "extends": "@omni/typescript-config/vite.json",
  "include": ["src", "vite.config.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/app/*": ["src/app/*"],
      "@/features/*": ["src/features/*"],
      "@/shared/*": ["src/shared/*"],
      "@/core/*": ["src/core/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/theme/*": ["src/theme/*"],
      "@/assets/*": ["src/assets/*"]
    }
  }
}
