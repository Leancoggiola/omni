{
  "extends": "@omni/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
