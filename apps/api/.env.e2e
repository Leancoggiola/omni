# Suite E2E. Apunta al contenedor efímero db-e2e de docker-compose.yml.
# Commiteado a propósito: no hay secretos reales acá, así la suite corre sin ningún setup previo.
# El guard del reset rechaza cualquier URL que no sea local o cuya base no termine en _test o _e2e.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/omni_e2e
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5434/omni_e2e

NODE_ENV=test
# El proxy de apps/web/vite.config.ts apunta fijo a localhost:3000.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Los límites son por IP y toda la suite sale desde 127.0.0.1, así que los agota enseguida
# (authLimiter permite 10 logins por 15 min y solo arrancar los workers consume más).
RATE_LIMIT_DISABLED=true

JWT_ACCESS_SECRET=e2e-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=e2e-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# La API llama a TMDB desde el servidor, así que se apunta al stub que levanta Playwright.
TMDB_API_KEY=e2e-tmdb-api-key
TMDB_BASE_URL=http://127.0.0.1:3199

# usernameSchema exige 6-20 caracteres alfanuméricos, así que "admin" no sería válido.
ADMIN_USERNAME=e2eadmin
ADMIN_PASSWORD=e2eadminpassword
