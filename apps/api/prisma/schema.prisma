generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Theme {
  light
  dark
  auto
}

enum MediaType {
  movie
  tv
}

enum MediaStatus {
  to_watch
  watching
  watched
}

model User {
  id                       String                   @id @default(cuid())
  username                 String                   @unique
  name                     String
  email                    String?                  @unique
  password                 String
  role                     Role                     @default(USER)
  avatarUrl                String?
  phone                    String?
  birthDate                DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  refreshTokens            RefreshToken[]
  preferences              UserPreferences?
  householdMember          HouseholdMember?
  createdMediaItems        MediaItem[]
  createdPantryProducts    PantryProduct[]
  createdShoppingListItems PantryShoppingListItem[]
  createdHouseholdInvites  HouseholdInvite[]        @relation("InviteCreatedBy")
  usedHouseholdInvites     HouseholdInvite[]        @relation("InviteUsedBy")
  gymPlans                 GymPlan[]
  splitFriends             SplitFriend[]
  gatherings               Gathering[]
  personalExpenses         PersonalExpense[]
  expenseReminders         ExpenseReminder[]
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Boolean  @default(false)
  theme         Theme    @default(light)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  previousTokenHash String?
  rotatedAt         DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([previousTokenHash])
}

model Household {
  id                String                   @id @default(cuid())
  createdAt         DateTime                 @default(now())
  members           HouseholdMember[]
  invites           HouseholdInvite[]
  mediaItems        MediaItem[]
  pantryProducts    PantryProduct[]
  shoppingListItems PantryShoppingListItem[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@index([householdId])
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  codeHash    String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

model MediaItem {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tmdbId      Int
  mediaType   MediaType
  title       String
  posterPath  String?
  status      MediaStatus @default(to_watch)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([householdId, tmdbId, mediaType])
}

enum GymPlanStatus {
  ACTIVE
  ARCHIVED
}

model GymPlan {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  status     GymPlanStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  days       GymPlanDay[]

  @@index([userId, status])
}

model GymPlanDay {
  id        String        @id @default(cuid())
  planId    String
  plan      GymPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int           @default(0)
  exercises GymExercise[]

  @@unique([planId, label])
}

model GymExercise {
  id              String     @id @default(cuid())
  dayId           String
  day             GymPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  name            String
  sets            Int?
  reps            String
  currentWeightKg Decimal?   @db.Decimal(8, 2)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([dayId])
}

enum PantryUnit {
  UNITS
  PACKAGES
}

enum PantryCategory {
  DAIRY
  MEAT
  FRUIT
  VEGETABLE
  GRAINS
  BEVERAGES
  SNACKS
  CONDIMENTS
  FROZEN
  CLEANING
}

enum PantryShoppingSource {
  AUTO
  MANUAL
}

model PantryProduct {
  id             String                   @id @default(cuid())
  householdId    String
  household      Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name           String
  nameNormalized String
  category       PantryCategory
  unit           PantryUnit
  quantity       Decimal                  @db.Decimal(10, 2)
  minQuantity    Decimal?                 @db.Decimal(10, 2)
  expiresAt      DateTime?                @db.Date
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  shoppingItems  PantryShoppingListItem[]

  @@unique([householdId, nameNormalized])
  @@index([householdId, category])
}

model PantryShoppingListItem {
  id              String               @id @default(cuid())
  householdId     String
  household       Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  pantryProductId String?
  pantryProduct   PantryProduct?       @relation(fields: [pantryProductId], references: [id], onDelete: SetNull)
  name            String
  source          PantryShoppingSource
  quantityToBuy   Decimal              @db.Decimal(10, 2)
  unit            PantryUnit
  checked         Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([householdId, checked])
}

model SplitFriend {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  nameNormalized String
  alias          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  participants   GatheringParticipant[]

  @@unique([userId, nameNormalized])
}

model Gathering {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  date         DateTime               @db.Date
  isSettled    Boolean                @default(false)
  settledAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  participants GatheringParticipant[]
  expenses     GatheringExpense[]

  @@index([userId, isSettled, date])
}

model GatheringParticipant {
  id          String             @id @default(cuid())
  gatheringId String
  gathering   Gathering          @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  friendId    String?
  friend      SplitFriend?       @relation(fields: [friendId], references: [id], onDelete: SetNull)
  displayName String
  expenses    GatheringExpense[]

  @@unique([gatheringId, displayName])
}

model GatheringExpense {
  id            String               @id @default(cuid())
  gatheringId   String
  gathering     Gathering            @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  participantId String
  participant   GatheringParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  amount        Decimal              @db.Decimal(12, 2)
  description   String?
  createdAt     DateTime             @default(now())

  @@index([gatheringId])
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  HEALTH
  EDUCATION
  HOME
  CLOTHING
  SERVICES
  SUBSCRIPTIONS
  OTHER
}

enum ExpenseReminderPriority {
  LOW
  MEDIUM
  HIGH
}

enum ExpenseReminderRecurrence {
  ONCE
  MONTHLY
}

enum ExpenseReminderStatus {
  PENDING
  COMPLETED
}

model PersonalExpense {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept    String
  amount     Decimal          @db.Decimal(12, 2)
  category   ExpenseCategory
  date       DateTime         @db.Date
  notes      String?
  reminderId String?
  reminder   ExpenseReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([reminderId])
  @@index([userId, date])
  @@index([userId, category, date])
}

model ExpenseReminder {
  id          String                    @id @default(cuid())
  userId      String
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime                  @db.Date
  anchorDay   Int
  priority    ExpenseReminderPriority   @default(MEDIUM)
  recurrence  ExpenseReminderRecurrence
  status      ExpenseReminderStatus     @default(PENDING)
  expenses    PersonalExpense[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([userId, status, dueDate])
}
