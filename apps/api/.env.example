# PostgreSQL (Supabase)
# Get connection strings from: Supabase Dashboard → Project Settings → Database
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# JWT. En producción los secretos tienen al menos 32 caracteres y son distintos entre sí
# (generar con `openssl rand -base64 32`).
# La vigencia (entero + s, m, h o d) es también la de las cookies y la de la fila del refresh token.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-32-chars-or-more
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MOBILE=90d

# Entorno. Obligatorio para `prisma db seed` (development, test o production).
NODE_ENV=development

# Server
PORT=3000

# CORS (optional; set to frontend origin in production, or leave unset for development)
# CORS_ORIGIN=http://localhost:3001

# Origin guard. Must match the x-origin-secret header the Vercel proxy adds.
# Required when NODE_ENV=production (the API refuses to start without it, including the Docker image).
# Leave unset in development: without it every request is accepted.
# ORIGIN_SECRET=a_long_random_string

# Global rate limit per client IP, per 15-minute window (optional; default 300)
# RATE_LIMIT_GLOBAL_MAX=300

# API Read Access Token de TMDB (themoviedb.org/settings/api), no la API key v3: se envía como Bearer.
TMDB_API_KEY=tmdb_read_access_token

# Admin seed (used by `prisma db seed` to create the first admin user)
# 6 a 20 letras o números: es lo que acepta el login.
ADMIN_USERNAME=adminuser
ADMIN_PASSWORD=changeme123

# Siembra usuarios (demouser1, demouser2) y películas de demo, con la contraseña de ADMIN_PASSWORD.
# Solo con `true`; no se admite con NODE_ENV=production.
# SEED_DEMO=true
