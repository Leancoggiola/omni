# Integration tests. Points at the ephemeral db-test container from docker-compose.yml.
# Committed on purpose: no real secrets here, so the suite runs with zero setup.
# The reset guard refuses any URL that is not local or whose database name does not end in _test.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/omni_test
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5433/omni_test

NODE_ENV=test

JWT_ACCESS_SECRET=integration-test-access-secret-min-32-chars
JWT_REFRESH_SECRET=integration-test-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TMDB_API_KEY=test-tmdb-api-key
