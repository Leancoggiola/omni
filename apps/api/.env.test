# Tests de integración. Apunta al contenedor efímero db-test de docker-compose.yml.
# Commiteado a propósito: no hay secretos reales acá, así la suite corre sin ningún setup previo.
# El guard del reset rechaza cualquier URL que no sea local o cuya base no termine en _test.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/omni_test
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5433/omni_test

NODE_ENV=test

JWT_ACCESS_SECRET=integration-test-access-secret-min-32-chars
JWT_REFRESH_SECRET=integration-test-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TMDB_API_KEY=test-tmdb-api-key
