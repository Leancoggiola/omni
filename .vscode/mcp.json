{
  "servers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=zbtkvtfwxpbbnytsntgw",
      "headers": {
        "Authorization": "Bearer ${input:supabaseAccessToken}"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@colbymchenry/codegraph", "serve", "--mcp"]
    },
    "mantine": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mantine/mcp-server"]
    }
  },
  "inputs": [
    {
      "id": "supabaseAccessToken",
      "type": "promptString",
      "description": "Supabase Personal Access Token",
      "password": true
    }
  ]
}
