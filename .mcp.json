{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ovuierirvttkunvonhhu&read_only=true",
      "headers": {
        "Authorization": "Bearer ${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/hooks/npx-mcp.mjs", "-y", "@colbymchenry/codegraph@1.6.2", "serve", "--mcp"]
    },
    "mantine": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/hooks/npx-mcp.mjs", "-y", "@mantine/mcp-server@9.7.2"]
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/hooks/npx-mcp.mjs", "-y", "@playwright/mcp@0.0.83", "--output-dir", ".playwright-mcp"]
    }
  }
}
